
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ajuste o RewriteBase para onde esse .htaccess está servido
    RewriteBase /ti/ti156/projetoTI/public/

    # Se o recurso não existir como arquivo ou diretório…
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # …envia tudo para index.php mantendo query string
    RewriteRule ^ index.php [QSA,L]
</IfModule>
